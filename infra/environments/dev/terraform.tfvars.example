# Copy to a protected local terraform.tfvars and set reviewed values.
subscription_id = "a7255fdc-572a-4ea3-9d7e-ecb7ee5a87f1"
tenant_id       = "c69da7c1-f194-493b-9697-5b4bc8b56f37"
location        = "eastus2"
prefix          = "palancar"
environment     = "dev"

# Replace the placeholder with a stable lower-case suffix, or use auto.
state_suffix = "REPLACE_WITH_STABLE_SUFFIX_OR_auto"

budget_amount             = 100
# Replace the placeholder before plan; these contacts also receive relay operational alerts, and live validation rejects reserved domains.
budget_start_date         = "2026-08-01T00:00:00Z"
budget_end_date           = "2027-08-01T00:00:00Z"
budget_contact_emails     = ["owner@example.com"]
budget_forecast_threshold = 80

retention_in_days = 30

foundry_deployments = {}

# Replace the nil UUID with the reviewed Entra object ID for the smoke operator.
# Do not commit the live principal ID.
operator_principal_id = "00000000-0000-0000-0000-000000000000"

# Optional relay workload. A deployed workload requires the exact single
# transcription deployment shown below, three exact immutable images from the
# same development ACR, and the complete OpenRouter sidecar configuration.
deploy_relay_workload       = false
relay_image_digest          = ""
expiry_cleanup_image_digest = ""
relay_min_replicas          = 1

# Keep this synthetic origin until physical Even WebView evidence supplies a
# reviewed exact origin. Null browser origins remain rejected by default.
browser_allowed_origins   = ["https://even-webview.synthetic.invalid"]
allow_null_browser_origin  = false

# Optional OpenRouter-only LiteLLM sidecar. Keep every value empty when disabled.
enable_litellm_sidecar = false
litellm_image_digest   = ""
litellm_backend        = ""
litellm_upstream_model = ""

openrouter_api_key_secret_url = ""
litellm_master_key_secret_url = ""
azure_api_base                 = ""
azure_api_version              = ""

# Final enabled workload example. Keep the model map exactly as shown; the
# relay's fixed internal generation alias is palancar-generation and LiteLLM's
# provider-prefixed upstream model uses the openrouter/openai convention.
