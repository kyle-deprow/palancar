# litellm_backend = "openrouter"
# litellm_upstream_model = "openrouter/openai/gpt-5.6-luna"
# azure_api_base = ""
# azure_api_version = ""
# The secret URLs are exact, versionless Key Vault references; no live key is
# stored in Terraform.
# openrouter_api_key_secret_url = "https://<workload-vault>.vault.azure.net/secrets/openrouter-api-key"
# litellm_master_key_secret_url = "https://<workload-vault>.vault.azure.net/secrets/litellm-master-key"
