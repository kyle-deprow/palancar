{
  "name": "@palancar/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.44",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@palancar/audio": "0.1.0",
    "@palancar/contracts": "0.1.0",
    "@palancar/generation": "0.1.0",
    "@palancar/language-registry": "0.1.0",
    "@palancar/security-state": "0.1.0",
    "@palancar/telemetry": "0.1.0",
    "@palancar/transcription": "0.1.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "container:build": "docker build -f Dockerfile -t palancar-relay:local ../..",
    "container:smoke": "node scripts/smoke-container.mjs"
  }
}
